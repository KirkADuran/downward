(define (problem logistics-ipc-025-heavy)
  (:domain logistics)

  (:objects
    cit1 cit2 cit3 cit4 cit5 - city
    apt1 apt2 apt3 apt4 apt5 pos1 pos2 pos3 pos4 pos5 - location
    tru1 tru2 tru3 tru4 tru5 - truck
    apn1 apn2 - airplane
    obj11 obj12 obj13 obj21 obj22 obj23 obj31 obj32 obj33 obj41 obj42 obj43 obj51 obj52 obj53 - package
  )

  (:init
    (= (total-cost) 0)
    (= (package-cost obj11) 1)
    (= (package-cost obj12) 1)
    (= (package-cost obj13) 1)
    (= (package-cost obj21) 1)
    (= (package-cost obj22) 1)
    (= (package-cost obj23) 1)
    (= (package-cost obj31) 1)
    (= (package-cost obj32) 1)
    (= (package-cost obj33) 1)
    (= (package-cost obj41) 1)
    (= (package-cost obj42) 1)
    (= (package-cost obj43) 10)
    (= (package-cost obj51) 10)
    (= (package-cost obj52) 10)
    (= (package-cost obj53) 10)
    (= (drive-cost) 1)
    (= (fly-cost) 1)
    (at apn1 apt2)
    (at apn2 apt2)
    (at tru1 pos1)
    (at-package obj11 pos1)
    (at-package obj12 pos1)
    (at-package obj13 pos1)
    (at tru2 pos2)
    (at-package obj21 pos2)
    (at-package obj22 pos2)
    (at-package obj23 pos2)
    (at tru3 pos3)
    (at-package obj31 pos3)
    (at-package obj32 pos3)
    (at-package obj33 pos3)
    (at tru4 pos4)
    (at-package obj41 pos4)
    (at-package obj42 pos4)
    (at-package obj43 pos4)
    (at tru5 pos5)
    (at-package obj51 pos5)
    (at-package obj52 pos5)
    (at-package obj53 pos5)
    (in-city pos1 cit1)
    (in-city apt1 cit1)
    (in-city pos2 cit2)
    (in-city apt2 cit2)
    (in-city pos3 cit3)
    (in-city apt3 cit3)
    (in-city pos4 cit4)
    (in-city apt4 cit4)
    (in-city pos5 cit5)
    (in-city apt5 cit5)
  )

  (:goal
    (and
      (at-package obj51 apt5)
      (at-package obj53 apt5)
      (at-package obj23 pos2)
      (at-package obj31 pos5)
      (at-package obj12 apt3)
      (at-package obj32 pos4)
      (at-package obj13 apt1)
      (at-package obj42 pos4)
      (at-package obj41 apt3)
      (at-package obj11 apt4)
      (at-package obj22 pos4)
      (at-package obj43 apt5)
      (at-package obj33 pos3)
      (at-package obj21 pos5)
    )
  )

  (:metric minimize (total-cost))
)

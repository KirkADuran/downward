(define (problem logistics-ipc-020-heavy)
  (:domain logistics)

  (:objects
    cit1 cit2 cit3 cit4 - city
    apt1 apt2 apt3 apt4 pos1 pos2 pos3 pos4 - location
    tru1 tru2 tru3 tru4 - truck
    apn1 - airplane
    obj11 obj12 obj13 obj21 obj22 obj23 obj31 obj32 obj33 obj41 obj42 obj43 - package
  )

  (:init
    (= (total-cost) 0)
    (= (package-cost obj11) 1)
    (= (package-cost obj12) 1)
    (= (package-cost obj13) 1)
    (= (package-cost obj21) 1)
    (= (package-cost obj22) 1)
    (= (package-cost obj23) 1)
    (= (package-cost obj31) 1)
    (= (package-cost obj32) 1)
    (= (package-cost obj33) 1)
    (= (package-cost obj41) 10)
    (= (package-cost obj42) 10)
    (= (package-cost obj43) 10)
    (= (drive-cost) 1)
    (= (fly-cost) 1)
    (at apn1 apt3)
    (at tru1 pos1)
    (at-package obj11 pos1)
    (at-package obj12 pos1)
    (at-package obj13 pos1)
    (at tru2 pos2)
    (at-package obj21 pos2)
    (at-package obj22 pos2)
    (at-package obj23 pos2)
    (at tru3 pos3)
    (at-package obj31 pos3)
    (at-package obj32 pos3)
    (at-package obj33 pos3)
    (at tru4 pos4)
    (at-package obj41 pos4)
    (at-package obj42 pos4)
    (at-package obj43 pos4)
    (in-city pos1 cit1)
    (in-city apt1 cit1)
    (in-city pos2 cit2)
    (in-city apt2 cit2)
    (in-city pos3 cit3)
    (in-city apt3 cit3)
    (in-city pos4 cit4)
    (in-city apt4 cit4)
  )

  (:goal
    (and
      (at-package obj13 pos2)
      (at-package obj21 apt3)
      (at-package obj42 pos4)
      (at-package obj41 pos2)
      (at-package obj11 apt2)
      (at-package obj22 pos4)
      (at-package obj23 apt4)
      (at-package obj32 apt3)
      (at-package obj12 apt3)
      (at-package obj33 pos2)
      (at-package obj43 pos1)
    )
  )

  (:metric minimize (total-cost))
)
